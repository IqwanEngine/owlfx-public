# -------------------------------------------------------------
# AI & APP CONFIGURATION
# -------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="https://www.owlfx.my"
VITE_CMS_ALERTS_ENDPOINT="https://script.google.com/macros/s/your_script_id/exec"

# -------------------------------------------------------------
# SUPABASE CONFIGURATION
# -------------------------------------------------------------
# URL Projek Supabase
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Kunci Awam (Frontend Vite)
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Kunci Rahsia Pelayan (Vercel Serverless Function - api/dispatch-alert.js)
# JANGAN LETAK PREFIX 'VITE_'
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# -------------------------------------------------------------
# TELEGRAM BOT 1: VIP NEWS ALERTS (api/dispatch-alert.js)
# -------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_vip_alert_bot_token_here"
TELEGRAM_VIP_ALERT_ID="-100xxxxxxxxxx"

# -------------------------------------------------------------
# TELEGRAM BOT 2: RESEARCH & ADVISORY DESK (api/dispatch-research.js)
# -------------------------------------------------------------
VITE_TELEGRAM_RESEARCH_BOT_TOKEN="your_research_bot_token_here"
VITE_TELEGRAM_RESEARCH_CHAT_ID="your_personal_telegram_chat_id_here"
